# Backend Environment Variables
# Copy this file to .env for local development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/femospace
# Or use a cloud MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/femospace

# JWT secrets
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe/Payment Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_key

# Google AI Configuration
GEMINI_API_KEY=your_gemini_key

# Networking
# Production frontend URL (used for CORS)
FRONTEND_URL=https://femospace.space
# Backend's own URL (used for building file URLs)
BACKEND_URL=https://femospace.onrender.com
