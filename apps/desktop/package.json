{
  "name": "femo-pc-app",
  "version": "0.1.0",
  "private": true,
  "description": "PC wrapper for the Femo Space web app",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm --prefix ../web run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "cross-env NODE_ENV=production electron .",
    "build:web": "npm --prefix ../web run build",
    "build": "npm run build:web",
    "package": "npm run build:web && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  }
}