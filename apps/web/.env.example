# Frontend Environment Variables
# Copy this file to .env.local for local development

# API base URL - points to the backend server
# Production: https://femospace.onrender.com
# Development: http://localhost:3000
VITE_API_BASE_URL=https://femospace.onrender.com

# Socket.io URL (defaults to VITE_API_BASE_URL if not set)
# VITE_SOCKET_URL=https://femospace.onrender.com
